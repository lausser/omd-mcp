# =============================================================================
# Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# 
# Usage: docker-compose --env-file .env up -d
#

# =============================================================================
# Thruk MCP Configuration
# =============================================================================

# REQUIRED: Thruk API Key - use secret.key for multi-user chatbot sessions
# Get from: cat $OMD_ROOT/var/thruk/secret.key
# Or create user-specific key: thruk apikey create --user=USERNAME
THRUK_API_KEY=your_secret_key_here

# REQUIRED: Thruk base URL (including /thruk path)
THRUK_BASE_URL=https://your-thruk-server.com/thruk

# Optional: Thruk authentication user
THRUK_AUTH_USER=

# Optional: SSL certificate verification (true/false)
# Set to false for self-signed certificates (common in OMD installations)
# Default: true for containerized, false for OMD
THRUK_VERIFY_SSL=true

# =============================================================================
# LLM Provider Selection
# =============================================================================

# LLM provider to use: "openai" or "gemini" (default: openai)
LLM_PROVIDER=openai

# =============================================================================
# OpenAI Configuration (when LLM_PROVIDER=openai)
# =============================================================================

# REQUIRED: OpenAI API Key (or compatible API key)
OPENAI_API_KEY=your-api-key-here

# REQUIRED: API Base URL (OpenAI, Anthropic, local models, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# REQUIRED: Model name to use
OPENAI_MODEL=gpt-4

# =============================================================================
# Gemini Configuration (when LLM_PROVIDER=gemini)
# =============================================================================

# REQUIRED: Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL: Gemini Base URL (for on-premise deployments)
# Leave empty for cloud Gemini (Google AI Studio)
# Set for intranet: https://ai.internal.corp/v1
GEMINI_BASE_URL=

# REQUIRED: Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL: Enable Vertex AI protocol (true/false)
# Set to true for on-premise/enterprise deployments
# Set to false or leave empty for cloud Gemini
GEMINI_VERTEXAI=false

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level for all services (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Network Configuration (optional)
# =============================================================================

# Custom network name (default: mcp-network)
# COMPOSE_PROJECT_NAME=mcp

# =============================================================================
# Resource Limits (optional)
# =============================================================================

# Chatbot CPU limit (default: 1.0)
# CHATBOT_CPU_LIMIT=1.0

# Chatbot memory limit (default: 1G)
# CHATBOT_MEMORY_LIMIT=1G

# Thruk MCP CPU limit (default: 0.5)
# THRUK_CPU_LIMIT=0.5

# Thruk MCP memory limit (default: 512M)
# THRUK_MEMORY_LIMIT=512M

# =============================================================================
# Session Management Configuration
# =============================================================================

# Session timeout in minutes (default: 15)
SESSION_TIMEOUT_MINUTES=15

# Default username for standalone mode (no Apache proxy)
DEFAULT_USERNAME=chatuser

# Session cleanup interval in seconds (default: 60)
SESSION_CLEANUP_INTERVAL_SECONDS=60
