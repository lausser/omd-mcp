#!/bin/bash

### OMD INIT INFO
# PIDFILE:  tmp/run/chatbot.pid
# DEPENDS:  CONFIG_CHATBOT = on
# BINARY:   local/lib/python/bin/uvicorn
# ARGMATCH: chatbot.chatbot:app
### END INIT INFO

cd || exit 1
. etc/omd/site.conf
if [ "$CONFIG_CHATBOT" != "on" ] ; then
    exit 5
fi
. lib/omd/init_profile
. .profile

NAME="chatbot"
DAEMON=$OMD_ROOT/local/lib/python/bin/uvicorn
LOG_DIR=$OMD_ROOT/var/log
LOG_FILE=$OMD_ROOT/var/log/chatbot.log
PID_FILE=$OMD_ROOT/tmp/run/chatbot.pid
NOHUP=1
STORE_PID=1
START_TIMEOUT=30

# Set Python path to include chatbot code
# IMPORTANT: local/lib/python MUST come before lib/python to allow overriding OMD's old packages
# - $OMD_ROOT/local/lib/python contains site-specific packages (newer versions, installed by pip)
# - $OMD_ROOT/lib/python contains shared chatbot code and OMD system packages
export PYTHONPATH=$OMD_ROOT/local/lib/python:$OMD_ROOT/lib/python:$PYTHONPATH

# Chatbot configuration from site.conf (OMD integration only)
CHATBOT_PORT=${CONFIG_CHATBOT_TCP_PORT:-8000}
CHATBOT_HOST="127.0.0.1"

# Source application configuration
CHATBOT_CONF=$OMD_ROOT/etc/chatbot/chatbot.conf
if [ -f "$CHATBOT_CONF" ]; then
    . "$CHATBOT_CONF"
else
    # Defaults if config file doesn't exist
    SESSION_TIMEOUT_MINUTES=15
    DEFAULT_USERNAME="chatuser"
    SESSION_CLEANUP_INTERVAL_SECONDS=60
    LOG_LEVEL="INFO"
    LLM_PROVIDER="openai"
    OPENAI_API_KEY=""
    OPENAI_BASE_URL="https://api.openai.com/v1"
    OPENAI_MODEL="gpt-4"
    GEMINI_API_KEY=""
    GEMINI_BASE_URL=""
    GEMINI_MODEL="gemini-2.5-flash"
    GEMINI_VERTEXAI="false"
    THRUK_API_KEY=""
    THRUK_VERIFY_SSL="false"
fi

# Export environment variables for chatbot application
export SESSION_TIMEOUT_MINUTES
export DEFAULT_USERNAME
export SESSION_CLEANUP_INTERVAL_SECONDS
export LOG_LEVEL
export PORT=$CHATBOT_PORT
export HOST=$CHATBOT_HOST

# LLM Provider Configuration
export LLM_PROVIDER
export OPENAI_API_KEY
export OPENAI_BASE_URL
export OPENAI_MODEL
export GEMINI_API_KEY
export GEMINI_BASE_URL
export GEMINI_MODEL
export GEMINI_VERTEXAI

# Thruk MCP configuration (subprocess inherits these via env)
export THRUK_API_KEY
export THRUK_VERIFY_SSL
export THRUK_BASE_URL

# Note: Thruk MCP integration now uses stdio subprocess (no TCP port needed)
# The thruk_mcp.py subprocess auto-configures itself from OMD environment

mkdir -p "$LOG_DIR"

# Check if uvicorn is available
if ! command -v $DAEMON &>/dev/null; then
    echo "ERROR: uvicorn not found at $DAEMON"
    echo "Please install dependencies: cd /omd/sites/demo/lib/python/chatbot && ./install-deps.sh"
    echo "Or manually: python3 -m pip install fastapi>=0.65.0 uvicorn>=0.15.0 python-multipart"
    exit 1
fi

# Build uvicorn command options
OPTS="chatbot.chatbot:app --host $CHATBOT_HOST --port $CHATBOT_PORT --log-level info"

__init_hook $0 $1 pre
case "$1" in
  start)
    printf '%s' "Starting chatbot..."
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
      echo "already running"
      exit 0
    fi
    mkdir -p "$(dirname "$PID_FILE")"
    nohup $DAEMON $OPTS >> "$LOG_FILE" 2>&1 &
    PID=$!
    echo $PID > "$PID_FILE"
    sleep 1
    if kill -0 $PID 2>/dev/null; then
      echo "OK"
      __init_hook $0 $1 post 0
      exit 0
    else
      echo "FAILED"
      rm -f "$PID_FILE"
      __init_hook $0 $1 post 1
      exit 1
    fi
  ;;
  stop)
    printf '%s' "Stopping chatbot..."
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 $PID 2>/dev/null; then
        kill $PID
        for i in $(seq 30); do
          if ! kill -0 $PID 2>/dev/null; then
            rm -f "$PID_FILE"
            echo "OK"
            __init_hook $0 $1 post 0
            exit 0
          fi
          sleep 0.1
        done
        echo "timeout"
        __init_hook $0 $1 post 1
        exit 1
      else
        rm -f "$PID_FILE"
        echo "not running"
        exit 0
      fi
    else
      echo "not running"
      exit 0
    fi
  ;;
  status)
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
      echo "chatbot is running ($(cat $PID_FILE))"
      exit 0
    else
      echo "chatbot is NOT running"
      exit 1
    fi
  ;;
  restart)
    $0 stop
    sleep 1
    $0 start
  ;;
  reload)
    echo "Reloading chatbot..."
    $0 stop
    $0 start
  ;;
  check)
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|reload|status}"
    exit 1
  ;;
esac
