#!/bin/bash

# Alias: Thruk AI Chatbot
# Menu: Addons
# Description:
#  Enable the AI-powered chatbot that integrates with Thruk
#  monitoring system via Model Context Protocol (MCP).
#  Provides natural language interface to monitoring data.

case "$1" in
    default)
        echo "off"
    ;;
    choices)
        echo "on: enable chatbot"
        echo "off: disable chatbot"
    ;;
    set)
        # Remove Apache config symlink
        rm -f $OMD_ROOT/etc/apache/conf.d/chatbot.conf

        if [ "$2" == "on" ]; then
            # Ensure init script has execute permissions
            if [ -f $OMD_ROOT/etc/init.d/chatbot ]; then
                chmod 755 $OMD_ROOT/etc/init.d/chatbot
            fi

            # Remove old rc.d symlink if it exists without number prefix
            if [ -L $OMD_ROOT/etc/rc.d/chatbot ]; then
                rm -f $OMD_ROOT/etc/rc.d/chatbot
            fi

            # Create symlink to Apache config (generated by CHATBOT_TCP_PORT hook)
            ln -sf $OMD_ROOT/etc/chatbot/apache.conf \
                $OMD_ROOT/etc/apache/conf.d/chatbot.conf
        fi
    ;;
esac
